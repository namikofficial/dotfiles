#!/usr/bin/env bash
set -euo pipefail

has() { command -v "$1" >/dev/null 2>&1 && echo available || echo missing; }
echo "shell diagnostics"
echo "quickshell: $(quickshell --version 2>&1 | head -n1 || true)"
echo "hyprland: $(hyprctl version 2>/dev/null | head -n1 || echo unavailable)"
shell_pid="$(pgrep -x quickshell | head -n1 || true)"
if [ -n "$shell_pid" ]; then
  echo "shell process: $(ps -p "$shell_pid" -o pid=,comm=,args= | sed 's/^ *//')"
else
  echo "shell process: not-running"
fi
echo "notification owner: $(pgrep -af 'dunst|mako|swaync|wayle|quickshell' | rg 'dunst|mako|swaync|wayle' | head -n3 || echo none-detected)"
echo "audio: wpctl=$(has wpctl) pactl=$(has pactl)"
echo "network: nmcli=$(has nmcli)"
echo "bluetooth: bluetoothctl=$(has bluetoothctl)"
echo "calendar adapter: $(has gcalcli)"
echo "matugen: $(has matugen)"
echo "monitors:"
hyprctl monitors -j 2>/dev/null | jq -r '.[] | "  \(.name): \(.width)x\(.height) scale=\(.scale) focused=\(.focused)"' 2>/dev/null || echo "  unavailable outside Hyprland"
echo "ipc:"
if quickshell ipc -p "${XDG_CONFIG_HOME:-$HOME/.config}/noxflow/shell/shell.qml" call noxctl panelState >/dev/null 2>&1; then
  echo "  reachable"
else
  echo "  unavailable"
fi
