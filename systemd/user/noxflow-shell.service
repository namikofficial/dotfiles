[Unit]
Description=NoxFlow Quickshell desktop shell
PartOf=graphical-session.target
After=graphical-session.target noxd.service
Wants=noxd.service
OnFailure=noxflow-fallback.service
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.local/bin/noxflow-shell
KillSignal=SIGTERM
# The shell launches user-facing terminal actions (including yay/pacman)
# that must be able to ask sudo for authentication.
NoNewPrivileges=no
PrivateTmp=yes
SyslogIdentifier=noxflow-shell
# Silence exactly one Qt-internal category. QtWayland's text-input-v3 logs
# "disableSurface ... is focused" whenever keyboard focus moves between the
# shell's layer surfaces (launcher open/close); it is not a shell fault and
# releasing focus early did not stop it. Every other category still logs.
Environment=QT_LOGGING_RULES=qt.qpa.wayland.textinput.warning=false
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical-session.target
