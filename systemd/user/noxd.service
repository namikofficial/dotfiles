[Unit]
Description=NoxFlow desktop state daemon
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.local/bin/noxd
SyslogIdentifier=noxd
StandardOutput=journal
StandardError=journal
RuntimeDirectory=noxflow
RuntimeDirectoryMode=0700
StateDirectory=noxflow
UMask=0077
Restart=on-failure
RestartSec=2
ExecStartPre=-/usr/bin/mkdir -p %t/noxflow
Environment=XDG_RUNTIME_DIR=%t
KillSignal=SIGTERM
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=graphical-session.target
