# ---------------------------------------------------------------------------
# GitHub
#
# IPv4 only. GitHub's SSH front end has no usable AAAA record, so letting ssh
# try IPv6 first costs a connect timeout on every operation.
# ---------------------------------------------------------------------------

Host github.com
  AddressFamily inet

