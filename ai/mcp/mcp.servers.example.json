{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--autoConnect",
        "--no-usage-statistics"
      ]
    },
    "maestro": {
      "command": "maestro",
      "args": [
        "mcp"
      ]
    }
  }
}
