{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noxflow.local/schemas/nox-theme-schema-v1.json",
  "title": "NoxFlow generated theme",
  "type": "object",
  "required": ["schema", "policy_version", "source", "scheme", "colors", "effects", "motion", "validation", "selection"],
  "properties": {
    "schema": { "const": "nox-theme-schema-v1" },
    "policy_version": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "required": ["wallpaper", "sha256", "seed"],
      "properties": {
        "wallpaper": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "seed": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
      },
      "additionalProperties": false
    },
    "scheme": {
      "type": "object",
      "required": ["mode", "variant"],
      "properties": {
        "mode": { "enum": ["dark", "light", "oled"] },
        "variant": { "type": "string", "enum": ["dark", "neon", "muted", "vibrant", "minimal", "bright", "pastel", "calm", "balanced", "vibrant", "ambient", "focus", "performance", "content"] }
      },
      "additionalProperties": false
    },
    "colors": {
      "type": "object",
      "required": [
        "background", "onBackground",
        "surfaceCanvas", "surfaceBase", "surface1", "surface2", "surface3", "surfaceFloating",
        "onSurface", "onSurfaceVariant",
        "primary", "onPrimary", "primaryContainer", "onPrimaryContainer",
        "secondary", "onSecondary", "secondaryContainer", "onSecondaryContainer",
        "tertiary", "onTertiary", "tertiaryContainer", "onTertiaryContainer",
        "neutral", "onNeutral", "neutralContainer", "onNeutralContainer",
        "neutralVariant", "onNeutralVariant",
        "error", "warning", "success", "info",
        "outline", "outlineSubtle", "outlineStrong",
        "accent",
        "terminal"
      ],
      "additionalProperties": true
    },
    "accent": {
      "type": "object",
      "required": ["primary", "secondary", "tertiary", "hover", "pressed", "focus"],
      "additionalProperties": false
    },
    "terminal": {
      "type": "object",
      "required": ["background", "foreground", "red", "green", "yellow", "blue"],
      "additionalProperties": true
    },
    "effects": {
      "type": "object",
      "required": ["surfaceOpacity", "scrimOpacity", "blur"],
      "additionalProperties": false
    },
    "motion": {
      "type": "object",
      "required": ["themeTransitionMs"],
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "required": ["contrast", "passed", "failed"],
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "required": ["entropy", "candidateCount", "explanation", "personality"],
      "additionalProperties": false
    },
    "personality": {
      "type": "object",
      "required": ["class", "mode", "entropy", "avgChroma", "avgLuminance", "maxChroma", "chromaBoost", "warmth", "contrastMult"],
      "properties": {
        "class": { "type": "string", "enum": ["dark", "neon", "muted", "vibrant", "minimal", "bright", "pastel"] },
        "mode": { "type": "string", "enum": ["dark", "light", "oled"] },
        "entropy": { "type": "number", "minimum": 0 },
        "avgChroma": { "type": "number", "minimum": 0 },
        "avgLuminance": { "type": "number", "minimum": 0, "maximum": 1 },
        "maxChroma": { "type": "number", "minimum": 0 },
        "chromaBoost": { "type": "number", "minimum": 0 },
        "warmth": { "type": "number", "minimum": -1, "maximum": 1 },
        "contrastMult": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
