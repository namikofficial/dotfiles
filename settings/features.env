#!/usr/bin/env sh
# Startup feature flags for the Hyprland session.
# Source this file to override defaults set in startup.sh and uwsm/env-hyprland.
# Changes here take effect on next login.

# Warm desktop app binaries in page cache at login (reduces first-launch latency).
export HYPR_WARM_DESKTOP_APPS=1

# Pre-launch browser in background so it opens fast.
# Off by default to keep login snappy.
export HYPR_PRELAUNCH_BROWSER=0

# Reload hyprpm plugins at login.
# Off until "hyprpm reload" header refresh is fixed in Hyprland >=0.54.
export HYPR_USE_HYPRPM_RELOAD=0

# Load hyprexpo plugin at session start.
# Off by default; Super+Tab loads it on demand.
export HYPR_LOAD_HYPREXPO_AT_STARTUP=0

# GPU routing mode for AQ_DRM_DEVICES.
#   hybrid  – Intel first, then NVIDIA (default for laptops)
#   intel   – Intel iGPU only
#   nvidia  – NVIDIA dGPU only
export HYPR_AQ_GPU_MODE=intel
