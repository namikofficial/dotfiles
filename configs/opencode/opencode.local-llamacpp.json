{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (local CUDA)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "local"
      },
      "models": {
         "local": {
           "name": "local",
           "tools": true
         },
         "qwen3-8b": {
           "name": "qwen3-8b",
           "tools": true
         },
         "qwen-coder-7b": {
           "name": "qwen-coder-7b",
           "tools": true
         },
         "gemma-3-4b": {
           "name": "gemma-3-4b",
           "tools": true
         },
         "deepseek-r1-7b": {
           "name": "deepseek-r1-7b",
           "tools": false
         },
         "phi-4-mini": {
           "name": "phi-4-mini",
           "tools": true
         }
       }
    },
    "minmax": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "MinMax",
      "options": {
        "baseURL": "https://api.minimax.io/v1",
        "apiKey": "{file:~/.config/opencode/keys/minmax.key}"
      },
      "models": {
        "MiniMax-M2.7": {
          "name": "MiniMax-M2.7",
          "tools": true
        },
        "MiniMax-M2.7-highspeed": {
          "name": "MiniMax-M2.7-highspeed",
          "tools": true
        },
        "MiniMax-M3": {
          "name": "MiniMax-M3",
          "tools": true
        }
      }
    },
    "cerebras": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Cerebras",
      "options": {
        "baseURL": "https://api.cerebras.ai/v1",
        "apiKey": "{file:~/.config/opencode/keys/cerebras.key}"
      },
      "models": {
        "gpt-oss-120b": {
          "name": "gpt-oss-120b",
          "tools": true
        },
        "zai-glm-4.7": {
          "name": "zai-glm-4.7",
          "tools": true
        }
      }
    }
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp"],
      "enabled": true,
      "timeout": 8000
    },
    "browser": {
      "type": "local",
      "command": ["npx", "-y", "@browsermcp/mcp"],
      "enabled": true,
      "timeout": 8000
    },
    "obsidian": {
      "type": "local",
      "command": ["npx", "obsidian-mcp-server"],
      "environment": {
        "OBSIDIAN_API_KEY": "{env:OBSIDIAN_API_KEY}",
        "OBSIDIAN_BASE_URL": "{env:OBSIDIAN_BASE_URL}",
        "OBSIDIAN_VERIFY_SSL": "{env:OBSIDIAN_VERIFY_SSL}",
        "OBSIDIAN_ENABLE_CACHE": "{env:OBSIDIAN_ENABLE_CACHE}"
      },
      "enabled": false,
      "timeout": 10000
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "timeout": 10000
    },
    "rag": {
      "type": "local",
      "command": ["/home/namik/Documents/code/dotfiles/system/rag-mcp.sh"],
      "enabled": true,
      "timeout": 8000
    }
  },
  "skills": {
    "paths": [
      "/home/namik/Documents/code/dotfiles/configs/opencode/skills",
      "/home/namik/.codex/skills"
    ]
  },
  "agent": {
    "minmax-subagent": {
      "description": "MinMax-backed coding subagent for implementation-heavy tasks.",
      "mode": "subagent",
      "model": "minmax/MiniMax-M2.7",
      "prompt": "You are a focused coding subagent. Inspect first, make the smallest correct change, run the most relevant checks you can, and report concrete results only."
    },
    "cerebras-backup-subagent": {
      "description": "Cerebras-backed fallback subagent for narrow coding or search tasks.",
      "mode": "subagent",
      "model": "cerebras/gpt-oss-120b",
      "prompt": "You are a fallback coding subagent. Stay narrow, avoid speculative rewrites, and return concise evidence-backed results."
    }
  },
  "model": "llamacpp/qwen-coder-7b",
  "small_model": "llamacpp/gemma-3-4b"
}
