# Copy to ~/.config/pal/env and configure at least one provider.
# Keep the real file private and out of this repository.

# Choose native provider keys or a unified provider; do not add placeholder keys.
# GEMINI_API_KEY=""
# OPENAI_API_KEY=""
# OPENROUTER_API_KEY=""
# XAI_API_KEY=""

# For an OpenAI-compatible local endpoint instead of a hosted provider:
# CUSTOM_API_URL="http://127.0.0.1:11434/v1"
# CUSTOM_MODEL_NAME="llama3.2"

DEFAULT_MODEL="auto"
DISABLED_TOOLS="analyze,refactor,testgen,secaudit,docgen,tracer"
