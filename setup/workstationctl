#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
STATE_ROOT=/var/lib/noxflow-workstation
VIRT_PACKAGES=(qemu-desktop libvirt virt-manager dnsmasq edk2-ovmf swtpm dmidecode)

ok() { printf 'OK   %s\n' "$*"; }
warn() { printf 'WARN %s\n' "$*" >&2; }
fail() { printf 'FAIL %s\n' "$*" >&2; return 1; }
need_root() { ((EUID == 0)) || { printf 'Run with sudo: sudo %q %s\n' "$0" "$*" >&2; exit 2; }; }

intel_card() {
  local vendor card
  for vendor in /sys/class/drm/card*/device/vendor; do
    [[ -r "$vendor" ]] || continue
    [[ "$(<"$vendor")" == 0x8086 ]] || continue
    card="${vendor%/device/vendor}"
    printf '/dev/dri/%s\n' "${card##*/}"
    return 0
  done
  return 1
}

verify_login() {
  local rc=0 id
  id="$(tr -d '[:space:]' <"$REPO_DIR/uwsm/default-id")"
  if [[ "$id" == hyprland.desktop ]]; then ok 'UWSM compositor ID is hyprland.desktop'; else fail "invalid UWSM ID: $id"; rc=1; fi
  if [[ "$(awk -F= '/^Session=/{print $2}' "$REPO_DIR/sddm/dmrc")" == hyprland-uwsm.desktop ]]; then ok 'SDDM launches the UWSM wrapper once'; else fail 'SDDM session is not hyprland-uwsm.desktop'; rc=1; fi
  if [[ ! -e "$HOME/.config/systemd/user/wayland-wm@hyprland.desktop.service.d/10-aq-drm-devices.conf" && ! -L "$HOME/.config/systemd/user/wayland-wm@hyprland.desktop.service.d/10-aq-drm-devices.conf" ]]; then ok 'obsolete AQ_DRM_DEVICES drop-in absent'; else fail 'obsolete AQ_DRM_DEVICES drop-in still exists'; rc=1; fi
  local igpu
  igpu="$(intel_card || true)"
  if [[ -n "$igpu" ]]; then ok "Intel recovery renderer: $igpu"; else fail 'Intel DRM card not found'; rc=1; fi
  if command -v uwsm >/dev/null; then ok 'uwsm installed'; else fail 'uwsm missing'; rc=1; fi
  if command -v Hyprland >/dev/null; then ok 'Hyprland installed'; else fail 'Hyprland missing'; rc=1; fi
  if systemctl is-active --quiet NetworkManager || systemctl is-active --quiet wpa_supplicant; then
    warn 'legacy NetworkManager/wpa_supplicant network stack is active'
    rc=1
  else
    ok 'iwd is the active Wi-Fi owner'
  fi
  return "$rc"
}

verify_kvm() {
  local rc=0
  local emulator_bin
  emulator_bin="$(command -v emulator 2>/dev/null || true)"
  [[ -n "$emulator_bin" ]] || emulator_bin="$HOME/Android/Sdk/emulator/emulator"
  if grep -qw vmx /proc/cpuinfo; then ok 'Intel VT-x exposed'; else fail 'Intel VT-x unavailable'; rc=1; fi
  if [[ -c /dev/kvm ]]; then ok '/dev/kvm exists'; else fail '/dev/kvm missing'; rc=1; fi
  if [[ -r /dev/kvm && -w /dev/kvm ]]; then ok 'current user can access /dev/kvm'; else fail 'current user cannot access /dev/kvm'; rc=1; fi
  if grep -q '^kvm_intel ' /proc/modules; then ok 'kvm_intel loaded'; else fail 'kvm_intel not loaded'; rc=1; fi
  if [[ -x "$emulator_bin" ]]; then ok "Android emulator available: $emulator_bin"; else warn 'Android emulator missing (run android-dev.sh install-emulator)'; rc=1; fi
  if [[ -x "$emulator_bin" ]] && "$emulator_bin" -accel-check 2>&1 | grep -q 'installed and usable'; then
    ok 'Android Emulator confirms KVM acceleration'
  else
    fail 'Android Emulator acceleration check failed'; rc=1
  fi
  if [[ -x "$emulator_bin" ]] && "$emulator_bin" -list-avds 2>/dev/null | grep -q .; then
    ok 'at least one Android AVD is configured'
  else
    warn 'no Android AVD is configured'; rc=1
  fi
  if command -v adb >/dev/null; then ok 'adb available'; else fail 'adb missing'; rc=1; fi
  if command -v virsh >/dev/null; then ok 'libvirt client installed'; else warn 'libvirt client not installed yet'; rc=1; fi
  return "$rc"
}

diagnose_login() {
  local out
  out="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/diagnostics/login-$(date +%Y%m%d-%H%M%S).log"
  mkdir -p "$(dirname "$out")"
  {
    printf 'Noxflow login diagnosis %s\n\n' "$(date -Is)"
    uname -a
    printf '\n== failed units ==\n'; systemctl --failed --no-pager || true
    printf '\n== display manager ==\n'; systemctl status display-manager --no-pager -l || true
    printf '\n== user session ==\n'; systemctl --user status 'wayland-wm@hyprland.desktop.service' --no-pager -l || true
    printf '\n== DRM ==\n'; for f in /sys/class/drm/card*/device/vendor; do [[ -r "$f" ]] && printf '%s %s\n' "$f" "$(<"$f")"; done
    printf '\n== SDDM journal ==\n'; journalctl -b -u sddm --no-pager -n 250 || true
    printf '\n== user warnings ==\n'; journalctl -b _UID="$(id -u)" -p warning..alert --no-pager -n 350 || true
  } >"$out" 2>&1
  printf '%s\n' "$out"
}

backup_system() {
  local stamp backup path
  stamp="$(date +%Y%m%d-%H%M%S)"
  backup="$STATE_ROOT/backups/$stamp"
  mkdir -p "$backup"
  for path in /etc/kernel/cmdline /etc/modprobe.d/nvidia.conf /etc/modprobe.d/nvidia-hybrid.conf /etc/modprobe.d/blacklist-nvidia-drm.conf /etc/udev/rules.d/60-nvidia.rules; do
    if [[ -e "$path" || -L "$path" ]]; then
      mkdir -p "$backup$(dirname "$path")"
      cp -a "$path" "$backup$path"
    fi
  done
  printf '%s\n' "$stamp" >"$STATE_ROOT/last-backup"
  printf '%s\n' "$backup"
}

apply_user() {
  "$SCRIPT_DIR/bootstrap.sh" --no-local-ai --no-zsh-plugins --no-tmux-plugins
  ln -sfn "$SCRIPT_DIR/workstationctl" "$HOME/.local/bin/workstationctl"
  ln -sfn "$REPO_DIR/android/android-env.sh" "$HOME/.config/environment.d/60-android.conf"
  ok 'user configuration linked'
}

plan_system() {
  cat <<EOF
Would apply the following root-owned profile:
  - back up managed NVIDIA and boot-entry files under $STATE_ROOT/backups
  - install the Intel-display/NVIDIA-compute stability policy
  - install the independent Hyprland recovery session
  - enable iwd, systemd-networkd, and systemd-resolved; disable legacy Wi-Fi services
  - mask unused systemd PCR-login measurement units
  - install: ${VIRT_PACKAGES[*]}
  - enable libvirt and add ${SUDO_USER:-namik} to kvm,libvirt
  - preserve the explicit iGPU-safe boot entry and rebuild initramfs
EOF
}

install_virtualization() {
  pacman -S --needed "${VIRT_PACKAGES[@]}"
  systemctl enable --now libvirtd.service
  virsh net-autostart default >/dev/null 2>&1 || true
  virsh net-start default >/dev/null 2>&1 || true
  local user="${SUDO_USER:-namik}"
  usermod -aG kvm,libvirt "$user"
  ok "KVM/libvirt installed; $user added to kvm and libvirt"
}

apply_system() {
  need_root apply-system
  local backup
  backup="$(backup_system)"
  install -Dm644 "$REPO_DIR/system/etc/modprobe.d/nvidia.conf" /etc/modprobe.d/nvidia.conf
  install -Dm644 "$REPO_DIR/system/etc/modprobe.d/nvidia-hybrid.conf" /etc/modprobe.d/nvidia-hybrid.conf
  install -Dm644 "$REPO_DIR/system/etc/modprobe.d/blacklist-nvidia-drm.conf" /etc/modprobe.d/blacklist-nvidia-drm.conf
  rm -f /etc/udev/rules.d/60-nvidia.rules
  install -Dm755 "$REPO_DIR/system/usr/local/bin/noxflow-hypr-recovery" /usr/local/bin/noxflow-hypr-recovery
  install -Dm644 "$REPO_DIR/system/usr/share/wayland-sessions/hyprland-recovery.desktop" /usr/share/wayland-sessions/hyprland-recovery.desktop
  install -Dm644 "$REPO_DIR/sddm/sddm.conf.d/10-noxflow-theme.conf" /etc/sddm.conf.d/10-noxflow-theme.conf
  install -d /usr/share/sddm/themes/noxflow
  cp -a "$REPO_DIR/sddm/noxflow/." /usr/share/sddm/themes/noxflow/
  if ! systemctl is-active --quiet iwd.service; then
    fail 'iwd is not active; refusing to alter the network stack'
    exit 1
  fi
  systemctl enable --now iwd.service systemd-networkd.service systemd-resolved.service
  systemctl disable --now NetworkManager.service wpa_supplicant.service 2>/dev/null || true
  systemctl enable sddm.service
  systemctl mask systemd-pcrlogin@.service 2>/dev/null || true
  systemctl disable nvidia-persistenced.service 2>/dev/null || true
  for entry in /boot/loader/entries/*.conf; do
    [[ -f "$entry" ]] || continue
    [[ "${entry##*/}" == *igpu-safe* ]] && continue
    mkdir -p "$(dirname "$backup${entry}")"
    cp -a "$entry" "$backup${entry}"
    if grep -Eq 'nvidia[-_]drm\.modeset=' "$entry"; then
      sed -i -E 's/nvidia[-_]drm\.modeset=[01]/nvidia_drm.modeset=0/g' "$entry"
    else
      sed -i -E '/^options[[:space:]]+/ s|$| nvidia_drm.modeset=0|' "$entry"
    fi
  done
  if [[ -f /etc/kernel/cmdline ]]; then
    if grep -Eq 'nvidia[-_]drm\.modeset=' /etc/kernel/cmdline; then
      sed -i -E 's/nvidia[-_]drm\.modeset=[01]/nvidia_drm.modeset=0/g' /etc/kernel/cmdline
    else
      sed -i -E 's|$| nvidia_drm.modeset=0|' /etc/kernel/cmdline
    fi
  fi
  install_virtualization
  mkinitcpio -P
  systemctl daemon-reload
  ok "system profile applied; backup: $backup"
  warn 'Reboot is required for module options and group membership'
}

rollback() {
  need_root rollback
  local stamp backup file rel
  stamp="$(cat "$STATE_ROOT/last-backup" 2>/dev/null || true)"
  [[ -n "$stamp" ]] || { fail 'no managed backup found'; exit 1; }
  backup="$STATE_ROOT/backups/$stamp"
  while IFS= read -r -d '' file; do
    rel="${file#"$backup"}"
    mkdir -p "$(dirname "$rel")"
    rm -f "$rel"
    cp -a "$file" "$rel"
  done < <(find "$backup" \( -type f -o -type l \) -print0)
  systemctl unmask systemd-pcrlogin@.service 2>/dev/null || true
  rm -f /usr/local/bin/noxflow-hypr-recovery /usr/share/wayland-sessions/hyprland-recovery.desktop
  mkinitcpio -P
  ok "restored $backup; reboot required"
}

usage() {
  cat <<'EOF'
Usage: workstationctl COMMAND
  apply-user       Link the canonical user configuration
  apply-system     Install system profile, KVM/libvirt, and recovery session (sudo)
  verify [all|login|kvm]
  diagnose login  Capture a login failure report
  rollback         Restore the last managed system backup (sudo)
EOF
}

command="${1:-}"
case "$command" in
  apply-user) apply_user ;;
  apply-system) if [[ "${2:-}" == --dry-run ]]; then plan_system; else apply_system; fi ;;
  verify)
    case "${2:-all}" in
      login) verify_login ;;
      kvm) verify_kvm ;;
      all) rc=0; verify_login || rc=1; verify_kvm || rc=1; exit "$rc" ;;
      *) usage; exit 2 ;;
    esac ;;
  diagnose) if [[ "${2:-}" == login ]]; then diagnose_login; else usage; exit 2; fi ;;
  rollback) rollback ;;
  *) usage; exit 2 ;;
esac
