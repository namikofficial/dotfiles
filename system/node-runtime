#!/usr/bin/env bash
set -euo pipefail

nvm_dir="${NVM_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/nvm}"
nvm_exec="$nvm_dir/nvm-exec"

if [[ ! -x "$nvm_exec" ]]; then
  printf 'node runtime bridge: NVM launcher is unavailable at %s\n' "$nvm_exec" >&2
  exit 127
fi

command_name="$(basename "$0")"
if [[ "$command_name" == "node-runtime" ]]; then
  if [[ "${1:-}" != "--command" || -z "${2:-}" ]]; then
    printf 'Usage: node-runtime --command COMMAND [ARG ...]\n' >&2
    exit 64
  fi
  shift
  command_name="$1"
  shift
fi

case "$command_name" in
  node | npm | npx | corepack) ;;
  *)
    printf 'node runtime bridge: unsupported command: %s\n' "$command_name" >&2
    exit 64
    ;;
esac

# nvm replaces an existing NVM bin entry in place instead of moving the newly
# selected version to the front. In long-lived agent sessions that can leave
# ~/.local/bin ahead of NVM, causing nvm's own `npm --version` probe to recurse
# through this bridge. Remove stale NVM bin entries so `nvm use` prepends the
# selected runtime ahead of the bridge.
clean_path=""
IFS=: read -r -a path_entries <<<"${PATH:-}"
for path_entry in "${path_entries[@]}"; do
  case "$path_entry" in
    "$nvm_dir"/versions/*/*/bin) continue ;;
  esac
  if [[ -n "$clean_path" ]]; then
    clean_path+=":"
  fi
  clean_path+="$path_entry"
done
export PATH="$clean_path"

if [[ -n "${AI_WORKBENCH_NODE_VERSION:-}" ]]; then
  export NODE_VERSION="$AI_WORKBENCH_NODE_VERSION"
else
  search_dir="$PWD"
  while [[ "$search_dir" != "/" && ! -f "$search_dir/.nvmrc" ]]; do
    search_dir="$(dirname "$search_dir")"
  done

  if [[ -f "$search_dir/.nvmrc" ]]; then
    # The nearest project contract wins over a NODE_VERSION inherited from a
    # long-lived terminal, agent, tmux server, or desktop process.
    unset NODE_VERSION
  else
    export NODE_VERSION=default
  fi
fi

exec "$nvm_exec" "$command_name" "$@"
