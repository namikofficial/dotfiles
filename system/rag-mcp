#!/usr/bin/env bash
# RAG MCP Server Wrapper
# Exposes RAG functionality as Model Context Protocol tools and resources

SOURCE_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SOURCE_PATH")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
VENV="${REPO_DIR}/ai-rag/.venv"

if [ ! -x "${VENV}/bin/python" ]; then
  printf 'RAG environment is not installed yet.\n'
  printf 'Run: %s/setup/install-local-rag-stack.sh\n' "$REPO_DIR"
  exit 1
fi

exec "${VENV}/bin/python" "${SCRIPT_DIR}/rag_mcp.py" "$@"