logs/
logs/*.log
logs/*-latest.log
.codex
__pycache__/
*.pyc
settings/state.local.json
settings/export/
*.bak.*

# RAG runtime artifacts (keep durable notes like .agent/memory.md tracked if desired)
.agent/archive/
.agent/rag-runs/
.agent/subtasks/
.agent/task-graph.json
.agent/task.md
.agent/context.md
.agent/handoff.md
.agent/outcomes.jsonl

# OpenCode runtime state; keep durable config under configs/opencode tracked.
.opencode-cache/
.opencode-share/
.opencode-state/

# Rust build output (Cargo.lock is kept tracked for the desktop binaries).
**/target/

# Local NoxFlow runtime/configuration artifacts. Source configuration belongs in
# config/, theme/, and systemd/ and must remain tracked.
.noxflow/
noxflow.local.toml
noxflow-*.log

# Calendar sync (Waylandar-style): OAuth tokens, credentials, config, cache
external/waylandar-backend/config.json
external/waylandar-backend/token_*.json
external/waylandar-backend/credentials.json
external/waylandar-backend/*.ics
external/waylandar-backend/__pycache__/
external/waylandar-backend/cache_*.json
.codegraph/
